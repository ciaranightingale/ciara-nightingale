# Spotify — fills the "Music on Repeat" column with your real top tracks.
# Without these the site falls back to the hand-written list in lib/content.ts.
#
# 1. Create an app at https://developer.spotify.com/dashboard
#    Add http://127.0.0.1:8888/callback as a redirect URI.
# 2. Copy this file to .env.local and paste the app's client id and secret in.
# 3. Run `node scripts/spotify-refresh-token.mjs` and follow the printed steps.
#
# The app can stay in development mode — that restriction only applies to other
# people authorising, and you are the only account involved here.

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
